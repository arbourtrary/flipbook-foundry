{
	"name": "flipbook-foundry",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run build:assets && vite dev",
		"build": "npm run build:assets && vite build",
		"build:assets": "npm run build:font && npm run build:license",
		"build:font": "tsx scripts/build-font.ts",
		"build:license": "tsx scripts/build-license.ts",
		"generate:poses": "tsx scripts/generate-poses.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"@types/opentype.js": "^1.3.10",
		"@types/react": "^19.2.2",
		"@types/react-dom": "^19.2.2",
		"playwright-core": "^1.56.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tsx": "^4.22.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.7",
		"opentype.js": "^2.0.0",
		"svgpath": "^2.6.0",
		"wawoff2": "^2.0.1"
	}
}
