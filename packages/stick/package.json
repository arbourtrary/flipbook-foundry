	"description": "Stick figures for Flipbook Foundry: 92 actions baked into fonts.",
	"license": "OFL-1.1",
	"author": "arbourtrary",
	"homepage": "https://github.com/arbourtrary/flipbook-foundry#readme",
	"repository": {
